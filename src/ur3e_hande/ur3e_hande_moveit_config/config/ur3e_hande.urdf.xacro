<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="name">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import name urdf file -->
    <xacro:include filename="$(find ur3e_hande_description)/urdf/ur3e_hande.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="ur3e_hande.ros2_control.xacro" />

    <!-- HW interface in the works; NA for now -->
    <!-- <xacro:ur3e_hande_ros2_control name="robotiq_hande_controllers/RobotiqHandeHardwareInterface" initial_positions_file="$(arg initial_positions_file)"/> -->

</robot>
