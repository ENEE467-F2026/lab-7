<sdf version="1.6">
  <model name="cylinder">
    <pose>0 0 0.08 0 0 0</pose> 

    <link name="link">

      <!-- Inertia and Mass -->
      <inertial>
        <mass>0.05</mass>   
        <inertia>
          <ixx>1e-4</ixx>
          <iyy>1e-4</iyy>
          <izz>5e-6</izz>
        </inertia>
      </inertial>

      <!-- Visual -->
      <visual name="visual">
        <geometry>
          <cylinder>
            <radius>0.011</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.1 0.1 0.1 1</specular>
        </material>
      </visual>

      <!-- Collision -->
      <collision name="collision">
        <geometry>
          <cylinder>
            <radius>0.011</radius>
            <length>0.16</length>
          </cylinder>
        </geometry>

        <surface>

          <!-- contact model -->
          <contact>
            <ode>
              <kp>2e5</kp>
              <kd>200</kd>
              <max_vel>0.3</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>

          <!-- friction -->
          <friction>
            <ode>
              <mu>2</mu>       
              <mu2>2</mu2>     
            </ode>

            <torsional>
              <coefficient>0.8</coefficient>
              <use_patch_radius>true</use_patch_radius>
              <patch_radius>0.02</patch_radius>  
            </torsional>
          </friction>

        </surface>
      </collision>

    </link>

    <!-- Enable pose publishing on /model/<world_name>/cuboid/pose -->
    <plugin
    filename="gz-sim-pose-publisher-system"
    name="gz::sim::systems::PosePublisher">
    <use_pose_vector_msg>true</use_pose_vector_msg>
    <publish_nested_model_pose>true</publish_nested_model_pose>
    </plugin>

  </model>
</sdf>
